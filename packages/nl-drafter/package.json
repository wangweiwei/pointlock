{
  "name": "@pointlock/nl-drafter",
  "version": "0.1.3",
  "description": "NL → YAML draft assistant (03 §4.1/§4.1.1). Lives outside the trust boundary: it only drafts *.flow.yaml and asks structured elicitation questions; `pointlock compile` is the sole enforcer.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "The Pointlock Authors",
  "homepage": "https://github.com/wangweiwei/pointlock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangweiwei/pointlock.git",
    "directory": "packages/nl-drafter"
  },
  "bugs": {
    "url": "https://github.com/wangweiwei/pointlock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "default": "./dist/claude.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
