{
  "name": "@pointlock/walk-drafter",
  "version": "0.1.2",
  "description": "Walk-and-draft authoring: drive the live pages, ground every step on a real snapshot, execute it to prove the selector lands, and assemble a *.flow.yaml draft. Lives outside the trust boundary — `pointlock compile` is the sole enforcer.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "The Pointlock Authors",
  "homepage": "https://github.com/wangweiwei/pointlock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangweiwei/pointlock.git",
    "directory": "packages/walk-drafter"
  },
  "bugs": {
    "url": "https://github.com/wangweiwei/pointlock/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "private": true
}
