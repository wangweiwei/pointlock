# Normalize line endings across platforms.
* text=auto eol=lf

# Keep shell scripts LF regardless of platform.
*.sh text eol=lf

# Generated artifacts — exclude from GitHub language stats and collapse in diffs.
schema/generated/**  linguist-generated=true
schema/fixtures/**   linguist-generated=true
Cargo.lock           linguist-generated=true
pnpm-lock.yaml       linguist-generated=true

# Type-only generated packages.
packages/ir-types/dist/**         linguist-generated=true
packages/projection-types/dist/** linguist-generated=true

# Keep the language bar representative of hand-written code.
docs/**  linguist-documentation
